#!/usr/bin/env python3
"""
Installer - Robust Agent Skills Sync Script

A destructive, one-way sync tool to sync global agent skills from a source directory
to multiple target directories, ensuring clean states and validating structure.
Reads defaults from 'config.yaml' if present.
Runs natively on macOS (Apple Silicon or Intel) using only standard library modules.
"""

import os
import sys
import shutil
import argparse

# ANSI color codes for rich, professional CLI output
COLOR_RESET = "\033[0m"
COLOR_BOLD = "\033[1m"
COLOR_RED = "\033[31m"
COLOR_GREEN = "\033[32m"
COLOR_YELLOW = "\033[33m"
COLOR_BLUE = "\033[34m"
COLOR_CYAN = "\033[36m"

def log_info(msg: str):
    print(f"{COLOR_BLUE}[INFO]{COLOR_RESET} {msg}")

def log_success(msg: str):
    print(f"{COLOR_GREEN}[SUCCESS]{COLOR_RESET} {COLOR_BOLD}{msg}{COLOR_RESET}")

def log_warn(msg: str):
    print(f"{COLOR_YELLOW}[WARNING]{COLOR_RESET} {msg}")

def log_error(msg: str):
    print(f"{COLOR_RED}[ERROR]{COLOR_RESET} {COLOR_BOLD}{msg}{COLOR_RESET}", file=sys.stderr)

def load_config_yaml(file_path: str) -> dict:
    """Loads source and targets from YAML file. Has zero-dependency fallback parser."""
    try:
        import yaml
        with open(file_path, 'r') as f:
            data = yaml.safe_load(f)
            if isinstance(data, dict):
                return data
    except Exception:
        # Graceful fallback to parse simple yaml key-value structure without PyYAML
        pass

    config = {}
    if not os.path.exists(file_path):
        return config

    try:
        with open(file_path, 'r') as f:
            lines = f.readlines()
        
        in_targets = False
        in_prompts = False
        in_prompt_targets = False
        for line in lines:
            if not line.strip() or line.strip().startswith('#'):
                continue
            
            stripped = line.strip()
            if line.startswith('targets:'):
                in_targets = True
                in_prompts = False
                in_prompt_targets = False
                config["targets"] = []
                continue
            elif line.startswith('prompts:'):
                in_prompts = True
                in_targets = False
                in_prompt_targets = False
                continue
            elif line.startswith('source:'):
                val = stripped.split(':', 1)[1].strip().strip("'\"")
                config["source"] = val
                in_targets = False
                in_prompts = False
                in_prompt_targets = False
                continue
            
            if stripped.startswith('-') or stripped.startswith('*'):
                val = stripped[1:].strip().strip("'\"")
                if in_targets:
                    config["targets"].append(val)
                elif in_prompt_targets:
                    config["prompt_targets"].append(val)
                continue
            
            if ':' in stripped:
                key, val = [x.strip() for x in stripped.split(':', 1)]
                val = val.strip("'\"")
                if in_prompts and key == 'source':
                    config["prompt_source"] = val
                elif in_prompts and key == 'targets':
                    in_prompt_targets = True
                    config["prompt_targets"] = []
    except Exception as e:
        log_warn(f"Simple fallback YAML parser failed to read '{file_path}': {e}")
    
    return config

def main():
    # 1. Determine config path and load defaults
    script_dir = os.path.dirname(os.path.abspath(__file__))
    config_path = os.path.join(script_dir, "config.yaml")
    if not os.path.exists(config_path):
        config_path = "config.yaml"

    config_data = {}
    if os.path.exists(config_path):
        config_data = load_config_yaml(config_path)
        if config_data and "source" in config_data:
            log_info(f"Loaded configuration from '{COLOR_CYAN}{config_path}{COLOR_RESET}'")

    # Command-line defaults fallback to config file, then to hardcoded defaults
    fallback_source = config_data.get("source", "./skills")
    fallback_targets = config_data.get("targets", ["~/.gemini/antigravity/skills/", "~/.config/opencode/skills/"])

    prompts_cfg = config_data.get("prompts", {})
    if isinstance(prompts_cfg, dict):
        fallback_prompt_source = prompts_cfg.get("source", "IDE-AGENT.md")
        fallback_prompt_targets = prompts_cfg.get("targets", ["~/.config/opencode/AGENTS.md", "~/.gemini/GEMINI.md"])
    else:
        fallback_prompt_source = config_data.get("prompt_source", "IDE-AGENT.md")
        fallback_prompt_targets = config_data.get("prompt_targets", ["~/.config/opencode/AGENTS.md", "~/.gemini/GEMINI.md"])

    parser = argparse.ArgumentParser(
        description="Destructive, one-way sync of global agent skills with structural verification for Gemini CLI / Google Antigravity, OpenCode, Cursor, Windsurf, and VS Code / Copilot."
    )
    parser.add_argument(
        "--source",
        default=None,
        help=f"Source directory containing agent skills (default from config: {fallback_source})"
    )
    parser.add_argument(
        "--targets",
        nargs="+",
        default=None,
        help=f"Target directories to sync skills into (default from config: {fallback_targets})"
    )
    parser.add_argument(
        "--prompt-source",
        default=None,
        help=f"Source prompt file to sync (default from config: {fallback_prompt_source})"
    )
    parser.add_argument(
        "--prompt-targets",
        nargs="+",
        default=None,
        help=f"Target file destinations for default prompts (default from config: {fallback_prompt_targets})"
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Perform a trial run with no changes made to the targets"
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="Enable detailed diagnostic logging"
    )

    args = parser.parse_args()

    # Resolve args or fall back to config
    source_val = args.source if args.source is not None else fallback_source
    targets_val = args.targets if args.targets is not None else fallback_targets
    prompt_source_val = args.prompt_source if args.prompt_source is not None else fallback_prompt_source
    prompt_targets_val = args.prompt_targets if args.prompt_targets is not None else fallback_prompt_targets

    # 2. Resolve and validate source directory
    source_path = os.path.abspath(os.path.expanduser(source_val))
    if not os.path.isdir(source_path):
        log_error(f"Source directory '{source_val}' resolved to '{source_path}', but does not exist.")
        sys.exit(1)

    log_info(f"Source directory: {COLOR_CYAN}{source_path}{COLOR_RESET}")

    # 3. Scan source directory for skills (subdirectories)
    skills = []
    try:
        for item in sorted(os.listdir(source_path)):
            item_path = os.path.join(source_path, item)
            # Skip hidden files/directories (like .git, .DS_Store)
            if item.startswith('.'):
                continue
            if os.path.isdir(item_path):
                skills.append(item)
    except Exception as e:
        log_error(f"Failed to list source directory: {e}")
        sys.exit(1)

    if not skills:
        log_warn(f"No skill subdirectories found in source directory '{source_path}'.")
        sys.exit(0)

    log_info(f"Found {len(skills)} skill folders in source.")

    # 4. Perform asset structural check
    invalid_skills = []
    for skill in skills:
        skill_dir = os.path.join(source_path, skill)
        skill_md_path = os.path.join(skill_dir, "SKILL.md")
        if not os.path.isfile(skill_md_path):
            log_warn(f"Skill folder '{skill}' is missing required '{COLOR_BOLD}SKILL.md{COLOR_RESET}' file!")
            invalid_skills.append(skill)
        elif args.verbose:
            log_info(f"Validated structure for skill: '{skill}' (SKILL.md found)")

    # 5. Sync central resources to ~/.config/agent-skills/
    central_dir = "~/.config/agent-skills/"
    central_path = os.path.abspath(os.path.expanduser(central_dir))
    resources_to_sync = ["references", "agents", "docs", "hooks"]

    if args.dry_run:
        print(f"\n{COLOR_YELLOW}--- DRY RUN MODE (No central resources changes will be written) ---{COLOR_RESET}")

    print(f"\nProcessing central resources target: {COLOR_CYAN}{central_path}{COLOR_RESET}")
    if not args.dry_run:
        try:
            os.makedirs(central_path, exist_ok=True)
        except Exception as e:
            log_error(f"Failed to create central resources directory '{central_path}': {e}")
            sys.exit(1)

    for folder in resources_to_sync:
        src_dir = os.path.join(script_dir, folder)
        dest_dir = os.path.join(central_path, folder)

        if not os.path.isdir(src_dir):
            log_warn(f"Resource directory '{folder}' not found in script directory '{script_dir}', skipping.")
            continue

        if os.path.exists(dest_dir):
            if args.dry_run:
                print(f"  [Would Purge] {dest_dir}")
            else:
                if args.verbose:
                    log_info(f"Purging existing central folder: {dest_dir}")
                try:
                    if os.path.isdir(dest_dir) and not os.path.islink(dest_dir):
                        shutil.rmtree(dest_dir)
                    else:
                        os.remove(dest_dir)
                except Exception as e:
                    log_error(f"Failed to purge '{dest_dir}': {e}")
                    continue

        if args.dry_run:
            print(f"  [Would Copy]  {src_dir} -> {dest_dir}")
        else:
            if args.verbose:
                log_info(f"Copying {src_dir} -> {dest_dir}")
            try:
                shutil.copytree(src_dir, dest_dir)
            except Exception as e:
                log_error(f"Failed to copy '{src_dir}' to '{dest_dir}': {e}")
                continue

    # 6. Resolve and process targets
    resolved_targets = [os.path.abspath(os.path.expanduser(t)) for t in targets_val]

    if args.dry_run:
        print(f"\n{COLOR_YELLOW}--- DRY RUN MODE (No target skills changes will be written) ---{COLOR_RESET}")

    for target in resolved_targets:
        print(f"\nProcessing target: {COLOR_CYAN}{target}{COLOR_RESET}")
        
        # Ensure target base directory exists
        if not args.dry_run:
            try:
                os.makedirs(target, exist_ok=True)
            except Exception as e:
                log_error(f"Failed to create target directory '{target}': {e}")
                continue

        is_flat_target = "cursor/rules" in target.lower()

        for skill in skills:
            src_skill_dir = os.path.join(source_path, skill)
            src_skill_md = os.path.join(src_skill_dir, "SKILL.md")

            if is_flat_target:
                dest_file = os.path.join(target, f"{skill}.md")
                
                # Check if SKILL.md exists before copying
                if not os.path.isfile(src_skill_md):
                    continue

                if os.path.exists(dest_file):
                    if args.dry_run:
                        print(f"  [Would Purge] {dest_file}")
                    else:
                        if args.verbose:
                            log_info(f"Purging existing flat rule file: {dest_file}")
                        try:
                            os.remove(dest_file)
                        except Exception as e:
                            log_error(f"Failed to purge file '{dest_file}': {e}")
                            continue

                if args.dry_run:
                    print(f"  [Would Copy]  {src_skill_md} -> {dest_file}")
                else:
                    if args.verbose:
                        log_info(f"Copying flat skill {src_skill_md} -> {dest_file}")
                    try:
                        shutil.copy2(src_skill_md, dest_file)
                    except Exception as e:
                        log_error(f"Failed to copy '{src_skill_md}' to '{dest_file}': {e}")
                        continue
            else:
                dest_skill_dir = os.path.join(target, skill)

                # Purge the target directory if it exists to ensure a clean slate
                if os.path.exists(dest_skill_dir):
                    if args.dry_run:
                        print(f"  [Would Purge] {dest_skill_dir}")
                    else:
                        if args.verbose:
                            log_info(f"Purging existing target folder: {dest_skill_dir}")
                        try:
                            if os.path.isdir(dest_skill_dir) and not os.path.islink(dest_skill_dir):
                                shutil.rmtree(dest_skill_dir)
                            else:
                                os.remove(dest_skill_dir)
                        except Exception as e:
                            log_error(f"Failed to purge '{dest_skill_dir}': {e}")
                            continue
                
                # Copy source skill directory to target
                if args.dry_run:
                    print(f"  [Would Copy]  {src_skill_dir} -> {dest_skill_dir}")
                else:
                    if args.verbose:
                        log_info(f"Copying folder {src_skill_dir} -> {dest_skill_dir}")
                    try:
                        shutil.copytree(src_skill_dir, dest_skill_dir)
                    except Exception as e:
                        log_error(f"Failed to copy '{src_skill_dir}' to '{dest_skill_dir}': {e}")
                        continue

    # 7. Resolve and process default prompts
    prompt_src_path = os.path.abspath(os.path.expanduser(prompt_source_val))
    if not os.path.isabs(prompt_source_val):
        prompt_src_path = os.path.abspath(os.path.join(script_dir, prompt_source_val))

    if not os.path.isfile(prompt_src_path):
        log_error(f"Prompt source file '{prompt_source_val}' resolved to '{prompt_src_path}', but does not exist.")
        sys.exit(1)

    resolved_prompt_targets = [os.path.abspath(os.path.expanduser(t)) for t in prompt_targets_val]

    if args.dry_run:
        print(f"\n{COLOR_YELLOW}--- DRY RUN MODE (No default prompts changes will be written) ---{COLOR_RESET}")

    print(f"\nProcessing default prompts sync:")
    for target in resolved_prompt_targets:
        dest_parent = os.path.dirname(target)
        if not args.dry_run:
            try:
                os.makedirs(dest_parent, exist_ok=True)
            except Exception as e:
                log_error(f"Failed to create directory '{dest_parent}': {e}")
                continue

        if args.dry_run:
            print(f"  [Would Copy]  {prompt_src_path} -> {target}")
        else:
            try:
                shutil.copy2(prompt_src_path, target)
                log_info(f"Copied prompt: {COLOR_CYAN}{prompt_src_path}{COLOR_RESET} -> {COLOR_CYAN}{target}{COLOR_RESET}")
            except Exception as e:
                log_error(f"Failed to copy prompt to '{target}': {e}")

    if args.dry_run:
        print(f"\n{COLOR_YELLOW}--- Dry run completed. No modifications made. ---{COLOR_RESET}")
    else:
        print("")
        log_success("All skills and prompts synchronized successfully for Gemini CLI / Google Antigravity and other configured agents/IDEs!")
        if invalid_skills:
            log_warn(f"Note: The following skill folders lacked a 'SKILL.md' file: {', '.join(invalid_skills)}")

if __name__ == "__main__":
    main()
